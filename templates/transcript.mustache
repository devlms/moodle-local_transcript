{{!
    @template local_transcript/transcript

    One transcript as a document: institution, student, courses with completion date and grade. On the verify page
    it opens with the verdict (status), and for revoked, altered or unknown codes shows the verdict only (statusonly).

    Example context (json):
    {
        "institution": "Northfield College", "fullname": "Ines Duarte", "idnumber": "S-1001", "hasidnumber": true,
        "code": "K7QM-4XRT-9HCP", "issued": "6 November 2026", "showgrades": true, "hascourses": true,
        "courses": [{"shortname": "BIO1", "fullname": "Biology 1", "completed": "1 January 2026", "grade": "88.00"}],
        "status": {"state": "valid", "isvalid": true, "isbad": false, "isunknown": false, "title": "Valid", "message": "Issued by Northfield College on 6 November 2026."},
        "statusonly": false
    }
}}
<article class="local-transcript-sheet{{#status}} is-{{state}}{{/status}}">
    {{#status}}
    <header class="local-transcript-verdict">
        <span class="local-transcript-seal" aria-hidden="true">{{#isvalid}}{{#pix}}i/checked, core{{/pix}}{{/isvalid}}{{#isbad}}{{#pix}}i/invalid, core{{/pix}}{{/isbad}}{{#isunknown}}{{#pix}}i/warning, core{{/pix}}{{/isunknown}}</span>
        <div role="status">
            <p class="local-transcript-verdict-title">{{title}}</p>
            <p class="local-transcript-verdict-text">{{message}}</p>
        </div>
    </header>
    {{/status}}
    {{^statusonly}}
    <div class="local-transcript">
        <p class="local-transcript-issuer">{{institution}}</p>
        <h3 class="local-transcript-student">{{fullname}}</h3>
        <dl class="local-transcript-facts">
            {{#hasidnumber}}<div><dt>{{#str}}studentid, local_transcript{{/str}}</dt><dd>{{idnumber}}</dd></div>{{/hasidnumber}}
            {{#issued}}<div><dt>{{#str}}issuedon, local_transcript{{/str}}</dt><dd>{{issued}}</dd></div>{{/issued}}
            {{#code}}<div><dt>{{#str}}code, local_transcript{{/str}}</dt><dd class="local-transcript-code">{{code}}</dd></div>{{/code}}
        </dl>
        {{#hascourses}}
        <table class="local-transcript-courses">
            <thead><tr>
                <th scope="col">{{#str}}course, local_transcript{{/str}}</th>
                <th scope="col">{{#str}}completed, local_transcript{{/str}}</th>
                {{#showgrades}}<th scope="col" class="is-num">{{#str}}grade, local_transcript{{/str}}</th>{{/showgrades}}
            </tr></thead>
            <tbody>
            {{#courses}}
                <tr>
                    <td><span class="local-transcript-short">{{shortname}}</span> {{fullname}}</td>
                    <td>{{completed}}</td>
                    {{#showgrades}}<td class="is-num">{{grade}}</td>{{/showgrades}}
                </tr>
            {{/courses}}
            </tbody>
        </table>
        {{/hascourses}}
        {{^hascourses}}<p>{{#str}}nocourses, local_transcript{{/str}}</p>{{/hascourses}}
    </div>
    {{/statusonly}}
</article>
