{{!
    @template local_transcript/transcript

    One transcript: institution, student, courses with grade and completion date.

    Example context (json):
    {
        "institution": "Northfield College", "fullname": "Ines Duarte", "idnumber": "S-1001", "hasidnumber": true,
        "code": "K7QM-4XRT-9HCP", "issued": "6 November 2026", "showgrades": true, "hascourses": true,
        "courses": [{"shortname": "BIO1", "fullname": "Biology 1", "completed": "1 January 2026", "grade": "88.00"}]
    }
}}
<div class="local-transcript">
    <h3 class="h5 mb-1">{{institution}}</h3>
    <dl class="row mb-2">
        <dt class="col-sm-3">{{#str}}student, local_transcript{{/str}}</dt><dd class="col-sm-9">{{fullname}}</dd>
        {{#hasidnumber}}<dt class="col-sm-3">{{#str}}studentid, local_transcript{{/str}}</dt><dd class="col-sm-9">{{idnumber}}</dd>{{/hasidnumber}}
        {{#code}}<dt class="col-sm-3">{{#str}}code, local_transcript{{/str}}</dt><dd class="col-sm-9"><code>{{code}}</code></dd>{{/code}}
        {{#issued}}<dt class="col-sm-3">{{#str}}issuedon, local_transcript{{/str}}</dt><dd class="col-sm-9">{{issued}}</dd>{{/issued}}
    </dl>
    {{#hascourses}}
    <table class="table table-sm generaltable">
        <thead><tr>
            <th scope="col">{{#str}}course, local_transcript{{/str}}</th>
            {{#showgrades}}<th scope="col">{{#str}}grade, local_transcript{{/str}}</th>{{/showgrades}}
            <th scope="col">{{#str}}completed, local_transcript{{/str}}</th>
        </tr></thead>
        <tbody>
        {{#courses}}
            <tr><td><strong>{{shortname}}</strong> {{fullname}}</td>{{#showgrades}}<td>{{grade}}</td>{{/showgrades}}<td>{{completed}}</td></tr>
        {{/courses}}
        </tbody>
    </table>
    {{/hascourses}}
    {{^hascourses}}<p>{{#str}}nocourses, local_transcript{{/str}}</p>{{/hascourses}}
</div>
